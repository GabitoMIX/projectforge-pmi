# Normaliza los saltos de línea del repositorio.
# Evita que GitHub Desktop marque cambios innecesarios de LF a CRLF en Windows.

* text=auto

# Código fuente y documentación: usar LF
*.php  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Imágenes y binarios: no modificar
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
